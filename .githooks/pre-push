#!/bin/bash
# Local pre-push hook for valara-claude-plugin.
#
# Runs validate.sh + (if the Codex plugin clone is present) auto-syncs skills
# into it. This replaces the GitHub Actions workflow that previously enforced
# the same gates on push.
#
# Install once per clone: bash scripts/install-hooks.sh
# Bypass once (NOT recommended): git push --no-verify

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "[pre-push] Running scripts/validate.sh..."
if ! bash scripts/validate.sh; then
  echo "[pre-push] FAIL: validate.sh exited non-zero. Push aborted." >&2
  echo "[pre-push] Fix the validation gate or rerun with git push --no-verify (not recommended)." >&2
  exit 1
fi

# Read the range of commits being pushed from stdin (git pre-push protocol).
# If anything under skills/ or README.md changed in this push, AND a sibling
# codex plugin clone exists locally, sync to it.
SKILLS_TOUCHED=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range_start=""
  else
    range_start="$remote_sha"
  fi

  if [ -z "$range_start" ]; then
    diff_target="$local_sha"
  else
    diff_target="$range_start..$local_sha"
  fi

  if git diff --name-only "$diff_target" | grep -qE '^(skills/|README\.md$)'; then
    SKILLS_TOUCHED=1
    break
  fi
done

CODEX_PLUGIN_DIR="${CODEX_PLUGIN_DIR:-/home/jakep/valara-codex-plugin}"
if [ "$SKILLS_TOUCHED" -eq 1 ] && [ -d "$CODEX_PLUGIN_DIR/skills" ]; then
  echo "[pre-push] Skill change detected. Syncing into $CODEX_PLUGIN_DIR..."
  pushd "$CODEX_PLUGIN_DIR" >/dev/null
  bash scripts/sync-from-claude-plugin.sh
  if [ -n "$(git status --porcelain skills/)" ]; then
    echo "[pre-push] Codex skills drifted from canonical. Committing the sync."
    git add skills/
    git -c user.email='Jakepawl@users.noreply.github.com' -c user.name='Jakepawl' \
      commit -m "chore: sync skills from valara-claude-plugin@$(cd "$REPO_ROOT" && git rev-parse --short HEAD)"
    echo "[pre-push] Pushing the Codex sync commit..."
    git push origin main
    echo "[pre-push] Codex sync pushed."
  else
    echo "[pre-push] Codex skills already in sync. Nothing to commit."
  fi
  popd >/dev/null
elif [ "$SKILLS_TOUCHED" -eq 1 ]; then
  echo "[pre-push] WARN: Skill change detected but \$CODEX_PLUGIN_DIR not found at $CODEX_PLUGIN_DIR." >&2
  echo "[pre-push] Manually run sync after this push:" >&2
  echo "[pre-push]   cd /path/to/valara-codex-plugin && bash scripts/sync-from-claude-plugin.sh && git add skills/ && git commit -m 'chore: sync skills' && git push origin main" >&2
fi

echo "[pre-push] All gates passed. Proceeding with push."
